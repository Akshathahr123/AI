# TIC-TAC-TOE
# Human = X
# Computer = O

board = [' ' for _ in range(9)]


def print_board():
    print()
    print(f" {board[0]} | {board[1]} | {board[2]}")
    print("-----------")
    print(f" {board[3]} | {board[4]} | {board[5]}")
    print("-----------")
    print(f" {board[6]} | {board[7]} | {board[8]}")
    print()


def check_winner(player):
    winning_combinations = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_combinations:
        if board[a] == player and board[b] == player and board[c] == player:
            return True

    return False


def board_full():
    return ' ' not in board


def minimax(is_maximizing):
    # Computer wins
    if check_winner('O'):
        return 1

    # Human wins
    if check_winner('X'):
        return -1

    # Draw
    if board_full():
        return 0

    if is_maximizing:
        best_score = -1000

        for i in range(9):
            if board[i] == ' ':
                board[i] = 'O'
                score = minimax(False)
                board[i] = ' '
                best_score = max(best_score, score)

        return best_score

    else:
        best_score = 1000

        for i in range(9):
            if board[i] == ' ':
                board[i] = 'X'
                score = minimax(True)
                board[i] = ' '
                best_score = min(best_score, score)

        return best_score


def computer_move():
    best_score = -1000
    best_move = -1

    for i in range(9):
        if board[i] == ' ':
            board[i] = 'O'

            score = minimax(False)

            board[i] = ' '

            if score > best_score:
                best_score = score
                best_move = i

    board[best_move] = 'O'

    print("Computer chose position:", best_move + 1)


def get_human_move():
    while True:
        try:
            position = int(input("Enter position (1-9): "))

            # Check range
            if position < 1 or position > 9:
                print("Invalid position. Enter a number from 1 to 9.")
                continue

            # Convert 1-9 to 0-8
            index = position - 1

            # Check whether position is already occupied
            if board[index] != ' ':
                print("Position already taken. Try again.")
                continue

            return index

        except ValueError:
            print("Invalid input. Please enter a number.")


def play_game():
    print("TIC-TAC-TOE")
    print("You are X")
    print("Computer is O")

    print_board()

    while True:

        # --------------------
        # HUMAN TURN
        # --------------------
        move = get_human_move()
        board[move] = 'X'

        # Check human win
        if check_winner('X'):
            print_board()
            print("You win!")
            break

        # Check draw
        if board_full():
            print_board()
            print("Draw!")
            break

        # --------------------
        # COMPUTER TURN
        # --------------------
        computer_move()

        # Check computer win
        if check_winner('O'):
            print_board()
            print("Computer wins!")
            break

        # Check draw
        if board_full():
            print_board()
            print("Draw!")
            break

        print_board()


play_game()
