
import re

def parse(expr):
    expr = expr.strip()

    if "(" not in expr:
        return expr

    name, rest = expr.split("(", 1)
    rest = rest[:-1]

    args = []
    depth = 0
    start = 0

    for i, ch in enumerate(rest):
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == "," and depth == 0:
            args.append(parse(rest[start:i]))
            start = i + 1

    args.append(parse(rest[start:]))
    return (name.strip(), args)


def is_variable(x):
    return isinstance(x, str) and x[0].islower()


def apply_substitution(x, subst):
    if isinstance(x, str):
        while x in subst:
            x = subst[x]
        return x

    if isinstance(x, tuple):
        return (x[0], [
            apply_substitution(a, subst) for a in x[1]
        ])

    return x


def occurs(var, term, subst):
    term = apply_substitution(term, subst)

    if var == term:
        return True

    if isinstance(term, tuple):
        return any(occurs(var, a, subst) for a in term[1])

    return False


def unify(x, y, subst):
    x = apply_substitution(x, subst)
    y = apply_substitution(y, subst)

    if x == y:
        return subst

    if is_variable(x):
        if occurs(x, y, subst):
            return None
        subst[x] = y
        return subst

    if is_variable(y):
        if occurs(y, x, subst):
            return None
        subst[y] = x
        return subst

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x[1]) != len(y[1]):
            return None

        for a, b in zip(x[1], y[1]):
            subst = unify(a, b, subst)

            if subst is None:
                return None

        return subst

    return None


def display(x):
    if isinstance(x, tuple):
        return x[0] + "(" + ", ".join(
            display(a) for a in x[1]
        ) + ")"
    return str(x)


# Main program
e1 = input("Enter first expression: ")
e2 = input("Enter second expression: ")

x = parse(e1)
y = parse(e2)

result = unify(x, y, {})

if result is None:
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution Set:")

    for key, value in result.items():
        print(key, "=", display(value))

    print("Unified Expression:", display(
        apply_substitution(x, result)
    ))
